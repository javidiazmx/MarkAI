# Copy this file to .env and fill in the values (or run `mark init`, which does it for you).
# Never commit .env. Mark reads this file itself and hands the keys to the SDKs.

# REQUIRED - your Anthropic API key (https://console.anthropic.com/). Billing must be enabled.
ANTHROPIC_API_KEY=

# OPTIONAL - Voyage AI key for semantic (embedding) search. Without it Mark still works using
# keyword (BM25) search over your sources. https://www.voyageai.com/
# VOYAGE_API_KEY=
# MARKAI_EMBEDDING_MODEL=voyage-3.5

# OPTIONAL - Claude model and reasoning effort (low | medium | high | xhigh | max).
# 'medium' keeps chat answers quick; 'high' for tougher analysis (slower, costs more).
# MARKAI_MODEL=claude-opus-5
# MARKAI_EFFORT=medium
# MARKAI_MAX_TOKENS=16000

# OPTIONAL - where the knowledge base and raw downloads live (relative paths are resolved
# against the project folder, so `mark` works from any directory).
# MARKAI_DATA_DIR=data
# MARKAI_SOURCES_FILE=sources/sources.yaml

# OPTIONAL - retrieval tuning.
# MARKAI_TOP_K=8
# MARKAI_MIN_RELEVANCE=2.0
# MARKAI_WEAK_RELEVANCE=5.0

# OPTIONAL - ingestion.
# MARKAI_YOUTUBE_LANGUAGES=en,en-US
# MARKAI_CRAWL_DELAY_SECONDS=0.5
# MARKAI_TRANSCRIBE_MODEL=small        # podcast audio; requires: pip install "markai[transcribe]"

# OPTIONAL - web UI. Keep 127.0.0.1 unless you set an access code.
# MARKAI_WEB_HOST=127.0.0.1
# MARKAI_WEB_PORT=8000
# MARKAI_WEB_ACCESS_CODE=              # if set, the web UI asks for this code (header X-Access-Code)
# MARKAI_MAX_QUESTION_CHARS=4000
# MARKAI_DAILY_QUESTION_LIMIT=500      # global cap per UTC day, protects your API bill
# MARKAI_PER_SESSION_QUESTION_LIMIT=40

# OPTIONAL - the lead form. Two questions are answered, then the page asks who they are:
# name, email, phone, neighborhood. No password; the browser is remembered instead.
# MARKAI_FREE_QUESTIONS_BEFORE_SIGNUP=2
# MARKAI_ACCOUNT_REQUIRED=true         # false: never ask
# MARKAI_SESSION_DAYS=30
# MARKAI_COOKIE_SECURE=false           # TRUE the moment this is behind https

# WHERE THE LEAD GOES. Email is the LeadSimple route: it reads Name, Phone and Email out
# of the body. Nothing is lost while these are blank, leads queue and wait.
# `mark leads setup` asks for all of this and writes it here for you, checking the login
# first. `mark leads test` then sends one obviously fake lead to prove the wiring.
# MARKAI_LEAD_EMAIL_TO=                # e.g. new-deal........@newlead.leadsimple.com
# MARKAI_SMTP_HOST=                    # Google Workspace / Gmail: smtp.gmail.com
# MARKAI_SMTP_PORT=587                 # 465 uses SSL instead of STARTTLS
# MARKAI_SMTP_USERNAME=                # usually the sending address
# MARKAI_SMTP_PASSWORD=                # on Google this is an APP PASSWORD, not the login
# MARKAI_SMTP_FROM=                    # defaults to the username
# MARKAI_SMTP_STARTTLS=true

# Or a webhook instead, for a CRM with an inbound URL, or a Zapier / Make catch hook.
# MARKAI_CRM_WEBHOOK_URL=
# MARKAI_CRM_WEBHOOK_TOKEN=            # sent as: Authorization: Bearer ...
# MARKAI_CRM_WEBHOOK_HEADER=           # or one custom header, written as `Name: value`
